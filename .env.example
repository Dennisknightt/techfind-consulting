# Must be PostgreSQL — required everywhere, including local dev (Vercel's
# serverless functions have no persistent local disk for a SQLite file).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

SESSION_SECRET="change-me"
MOCK_PAYMENT_WEBHOOK_SECRET="change-me"

# Marketing-site admin endpoints (/api/leads, /api/communications, /admin) —
# required to view/manage marketing leads; unset means those endpoints
# reject every request (fail closed) rather than being open. See
# /docs/SECURITY.md for the known gap: the /admin page itself has no login
# of its own yet, so this alone does not gate the /admin UI.
ADMIN_SECRET="change-me"

# The CRM's own public URL — used both to build payment links and (once
# it's a real custom domain, not localhost or a *.vercel.app preview) as
# the single source of truth for src/middleware.ts's host-based split: that
# exact host serves only the CRM (/login, /app/*, /pay/*), and every other
# host redirects those same paths over to it instead of rendering them —
# so the marketing site and the CRM never visually mix, each on its own
# domain. See docs/ARCHITECTURE.md.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IntaSend — required for the INTASEND payment provider (M-Pesa STK push +
# card checkout) to be selectable at all; see src/server/payments/intasendProvider.ts.
# Both keys come from the IntaSend dashboard (Settings → API Keys) — use the
# LIVE keypair for production, not the test/sandbox one.
# NEXT_PUBLIC_INTASEND_PUBLISHABLE_KEY=
# INTASEND_SECRET_KEY=

# IntaSend webhook "challenge" secret — set to the same value configured in
# the IntaSend dashboard before going live, so forged webhook calls are
# rejected before touching the database. Optional in dev (unset = no check).
# INTASEND_WEBHOOK_CHALLENGE=

# Daraja — required for the DARAJA payment provider (direct Safaricom M-Pesa
# STK push, no aggregator) to be selectable; see
# src/server/payments/darajaProvider.ts. All four come from your app on
# https://developer.safaricom.co.ke — Consumer Key/Secret from the app
# itself, Shortcode + Passkey from "Lipa Na M-Pesa Online" for that app (Go
# Live gives production values; the sandbox 174379 shortcode + its
# well-known passkey work for testing before that).
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# "sandbox" or "production" — defaults to "production" when NODE_ENV is
# production, "sandbox" otherwise, so this is only needed to override that.
# MPESA_ENV=
# "CustomerPayBillOnline" (default) or "CustomerBuyGoodsOnline" — match
# whichever MPESA_SHORTCODE actually is (a paybill vs. a till number).
# MPESA_TRANSACTION_TYPE=

# ── Future real integrations (see /docs/INTEGRATIONS.md) ──
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# CARD_GATEWAY_SECRET_KEY=
# CARD_GATEWAY_WEBHOOK_SECRET=
# EMAIL_SMTP_URL=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
