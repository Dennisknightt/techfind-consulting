DATABASE_URL="file:./dev.db"

SESSION_SECRET="change-me"
MOCK_PAYMENT_WEBHOOK_SECRET="change-me"

# Marketing-site admin endpoints (/api/leads, /api/communications, /admin) —
# required to view/manage marketing leads; unset means those endpoints
# reject every request (fail closed) rather than being open. See
# /docs/SECURITY.md for the known gap: the /admin page itself has no login
# of its own yet, so this alone does not gate the /admin UI.
ADMIN_SECRET="change-me"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IntaSend webhook "challenge" secret — set to the same value configured in
# the IntaSend dashboard before going live, so forged webhook calls are
# rejected before touching the database. Optional in dev (unset = no check).
# INTASEND_WEBHOOK_CHALLENGE=

# ── Future real integrations (see /docs/INTEGRATIONS.md) ──
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# CARD_GATEWAY_SECRET_KEY=
# CARD_GATEWAY_WEBHOOK_SECRET=
# EMAIL_SMTP_URL=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
